{
  "name": "verdict",
  "displayName": "Verdict · VSCode 评测系统",
  "description": "在编辑器内完成出题、造数据、评测、重测、榜单与导出的本地评测系统。完全离线、零运行时依赖。",
  "version": "0.0.1",
  "publisher": "verdict-dev",
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=20"
  },
  "packageManager": "pnpm@11.26.0",
  "categories": [
    "Testing",
    "Other"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "watch": "node esbuild.js --watch",
    "build": "node esbuild.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "node ./test/runTest.js",
    "package": "vsce package",
    "vscode:prepublish": "node esbuild.js --production"
  },
  "contributes": {
    "commands": [
      {
        "command": "verdict.checkEnv",
        "title": "Verdict: 检查环境"
      }
    ],
    "configuration": {
      "title": "Verdict",
      "properties": {
        "verdict.compiler": {
          "type": "string",
          "default": "",
          "markdownDescription": "指定编译器可执行文件的完整路径。留空则自动探测 `g++` → `clang++` → `cl`。"
        },
        "verdict.flags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "-O2",
            "-std=c++17"
          ],
          "description": "编译参数。"
        },
        "verdict.debug": {
          "type": "boolean",
          "default": false,
          "description": "在输出通道中打印调试日志。"
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "1.95.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0",
    "vitest": "^5.0.0"
  }
}
